[Unit]
Description=ARK GEOAI password reset email worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/xuan1203
ExecStart=/home/xuan1203/venv/bin/python -u manage.py run_password_reset_mail
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
