SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USE_TLS=False
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate an independent key with python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_RESET_HMAC_KEY=
# Enable only with a trusted reverse proxy that overwrites X-Real-IP.
PASSWORD_RESET_TRUST_PROXY=False

# Export these in the Django process environment. Choose s3 or oss for new uploads.
CONTRIBUTION_STORAGE_PROVIDER=s3
# Private Alibaba Cloud OSS bucket with versioning enabled. Use its region ID (e.g. cn-hangzhou).
CONTRIBUTION_OSS_BUCKET=
CONTRIBUTION_OSS_REGION=
# Attach this RAM role to the ECS instance. Alternatively inject OSS_ACCESS_KEY_ID,
# OSS_ACCESS_KEY_SECRET and (for STS credentials) OSS_SESSION_TOKEN into the service.
CONTRIBUTION_OSS_RAM_ROLE=
# Use the HTTPS CNAME bound to the bucket when required by the Alibaba Cloud account.
CONTRIBUTION_OSS_PUBLIC_DOMAIN=
# Enable for Django on ECS in the same region as the bucket. APP URLs stay public.
CONTRIBUTION_OSS_USE_INTERNAL_ENDPOINT=False
# Private AWS S3 bucket and region (also used for existing S3 contributions).
CONTRIBUTION_STORAGE_BUCKET=
CONTRIBUTION_STORAGE_REGION=
CONTRIBUTION_UPLOAD_TTL=600
CONTRIBUTION_DOWNLOAD_TTL=300
# Prefer an IAM role. For local testing only, AWS SDK also accepts:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
