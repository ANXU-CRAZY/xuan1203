SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USE_TLS=False
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate an independent key with python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_RESET_HMAC_KEY=
# Enable only with a trusted reverse proxy that overwrites X-Real-IP.
PASSWORD_RESET_TRUST_PROXY=False

# Export these in the Django process environment. Use a private AWS S3 bucket.
CONTRIBUTION_STORAGE_BUCKET=
CONTRIBUTION_STORAGE_REGION=
CONTRIBUTION_UPLOAD_TTL=600
CONTRIBUTION_DOWNLOAD_TTL=300
# Prefer an IAM role. For local testing only, AWS SDK also accepts:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
